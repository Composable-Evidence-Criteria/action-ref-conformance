{
  "profile": "action-ref-v1-jcs-sha256",
  "version": 1,
  "spec": "https://github.com/giskard09/argentum-core/blob/action-ref-v1.0/docs/spec/action-ref.md",
  "note": "Expected verdicts for the action-ref-v1 conformance vectors. A conformant verifier recomputes action_ref = SHA-256(JCS(preimage)) over the 4-field tuple {action_type, agent_id, scope, timestamp}. It MUST reproduce PASS on positives (byte-identical digest) and MUST reproduce REJECT on negatives (either at the timestamp-grammar gate, reason=grammar_reject, before hashing at all; or by a digest mismatch against the tuple as received, reason=recompute_mismatch). A verifier that matches any claimed_action_ref in a REJECT vector has a conformance bug: it means an attacker could construct a colliding claim from a non-canonical byte form. The run must observe both verdicts and exercise every declared reason code \u2014 see verify.py.",
  "reject_reasons": {
    "grammar_reject": "timestamp is not a string in canonical RFC 3339 UTC form before hashing is attempted",
    "recompute_mismatch": "recomputed SHA-256(JCS(invocation_payload)) does not equal the claimed action_ref"
  },
